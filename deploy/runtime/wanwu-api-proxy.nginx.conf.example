# Included inside every API location; shared by the H5 and dedicated API hosts.
# Work ETags are used verbatim for If-Match. Gzip would turn a strong tag into
# W/"..." and make a valid autosave fail. Static H5 resources keep their gzip.
gzip off;
proxy_pass http://127.0.0.1:3100;
proxy_set_header Accept-Encoding "";
proxy_set_header Host wanwu-api.proterm.ink;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host $host;
proxy_connect_timeout 3s;
proxy_buffering off;
# Do not rewrite Cookie, Set-Cookie, Origin, CSRF or If-Match. No proxy cache.
