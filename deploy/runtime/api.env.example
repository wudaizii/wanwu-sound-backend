WANWU_DATABASE_URL=
WANWU_SESSION_SECRET=
WANWU_APP_ORIGIN=https://wanwu.proterm.ink
WANWU_CLOUD_AUTH_MODE=disabled
# Exact source IP observed for THIS container's trusted Nginx connection; never a subnet/hop count.
WANWU_TRUSTED_PROXY_ADDRESSES=
WANWU_OSS_BUCKET=wanwu-sound-dev-a7k3
WANWU_OSS_REGION=oss-cn-shanghai
WANWU_OSS_PREFIX=wanwu/prod
WANWU_OSS_ACCESS_KEY_ID=
WANWU_OSS_ACCESS_KEY_SECRET=
# Conservative admission reservations, not measured capacity or billing limits.
WANWU_ACCOUNT_STORAGE_BYTES=1073741824
WANWU_ACCOUNT_PENDING_SOURCES=5
WANWU_ACCOUNT_PENDING_RENDERS=3
WANWU_MEDIA_MAX_PENDING=50
