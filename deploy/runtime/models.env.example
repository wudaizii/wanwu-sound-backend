# 游客 AI 的内置模型配置。与 Compose 同目录的 .env.models（root 所有，权限 600）。
# API 显式加载；media/database/ops 不加载。只允许模型字段，不能覆盖认证或数据库。
# 不提交真实值，不发给前端或写进聊天。见 docs/P1_HARDENING.md。

# 语言模型（OpenAI 兼容 chat/completions）。三项都填才生效；留空 = 心情、讲解润色、AI 音符背景返回 not-open。
WANWU_LLM_BASE_URL=
WANWU_LLM_MODEL=
WANWU_LLM_API_KEY=

# 听音频的模型（教学音乐自动生成课本特征卡）：用上面语言模型的地址和 Key，只换模型名。留空 = 只用数字 + 语言模型。
WANWU_AUDIO_MODEL=

# 音乐模型（AI 音频背景）。WANWU_MUSIC_PROVIDER 留空 = 这一档关闭，页面自动用 AI 音符或本地背景。
# 目前只支持 fun-music（适配器待接口文档确认后实现）。
WANWU_MUSIC_PROVIDER=
WANWU_MUSIC_BASE_URL=
WANWU_MUSIC_MODEL=
WANWU_MUSIC_API_KEY=

# 内置配置每天最多实际尝试调用多少次（PG 原子计数，北京时间换日，重启不重置）。
# 听音/文本/修复分别计数，失败不退款；不是 token 或费用硬上限。
# 访客自己的 Key 不计入内置额度，但仍受全局 2 个网络调用并发限制。
WANWU_GUEST_AI_DAILY_LIMIT=2000
